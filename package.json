{
  "name": "traveller-world-map",
  "version": "0.1.0",
  "description": "Offline Traveller world map generator and editor with Foundry map exchange",
  "author": "Roy Martin",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "main": "desktop/main.cjs",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "electron .",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "dist": "electron-builder --win nsis portable --x64",
    "pack": "electron-builder --win --dir --x64"
  },
  "devDependencies": { "electron": "44.9.0", "electron-builder": "26.15.3" },
  "build": {
    "appId": "com.rtrm.travellerworldmap",
    "productName": "Traveller World Map",
    "files": ["desktop/**", "src/**", "build/icon.png", "index.html", "styles.css", "package.json", "README.md", "RULES.md"],
    "directories": { "output": "dist" },
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.ico", "signExecutable": false },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "artifactName": "Traveller-World-Map-Setup-${version}.${ext}" },
    "portable": { "artifactName": "Traveller-World-Map-Portable-${version}.${ext}" }
  }
}
